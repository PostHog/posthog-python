{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posthog.com/contracts/feature_flag_rules_v2/feature_flag_called_context.schema.json",
  "title": "$feature_flag_called context properties",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$feature_flag",
    "$feature_flag_response"
  ],
  "properties": {
    "$feature_flag": {
      "type": "string",
      "minLength": 1
    },
    "$feature_flag_response": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "$feature_flag_config_version": {
      "enum": [
        1,
        2
      ]
    },
    "$feature_flag_variant": {
      "type": "string"
    },
    "$feature_flag_rule_id": {
      "type": "string",
      "format": "uuid"
    },
    "$feature_flag_rule_type": {
      "enum": [
        "targeted_release",
        "percentage_rollout",
        "experiment"
      ]
    },
    "$feature_flag_experiment_id": {
      "type": "integer"
    },
    "$feature_flag_reason_code": {
      "type": "string",
      "minLength": 1
    },
    "$feature_flag_forced_variant": {
      "const": true
    }
  },
  "description": "Closed projection of the flag-access context properties. Existing capture fields are outside this projection. Complete v2 producer context follows the terminal outcome; tolerant-reader diagnostics may omit an incomplete attribution tuple.",
  "allOf": [
    {
      "if": {
        "required": [
          "$feature_flag_config_version"
        ],
        "properties": {
          "$feature_flag_config_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "$feature_flag_reason_code"
        ],
        "not": {
          "required": [
            "$feature_flag_forced_variant"
          ]
        },
        "oneOf": [
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "targeting_match"
              },
              "$feature_flag_rule_type": {
                "const": "targeted_release"
              }
            },
            "required": [
              "$feature_flag_rule_type",
              "$feature_flag_rule_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "targeting_match"
              },
              "$feature_flag_rule_type": {
                "const": "percentage_rollout"
              }
            },
            "required": [
              "$feature_flag_rule_type",
              "$feature_flag_rule_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "experiment_split"
              },
              "$feature_flag_rule_type": {
                "const": "experiment"
              }
            },
            "required": [
              "$feature_flag_rule_type",
              "$feature_flag_rule_id",
              "$feature_flag_variant"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "rollout_miss"
              },
              "$feature_flag_rule_type": {
                "const": "percentage_rollout"
              }
            },
            "required": [
              "$feature_flag_rule_type",
              "$feature_flag_rule_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "rollout_miss"
              },
              "$feature_flag_rule_type": {
                "const": "experiment"
              }
            },
            "required": [
              "$feature_flag_rule_type",
              "$feature_flag_rule_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "experiment_paused"
              },
              "$feature_flag_rule_type": {
                "const": "experiment"
              }
            },
            "required": [
              "$feature_flag_rule_type",
              "$feature_flag_rule_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "holdout"
              },
              "$feature_flag_rule_type": {
                "const": "experiment"
              }
            },
            "required": [
              "$feature_flag_rule_type",
              "$feature_flag_rule_id"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "no_rule_match"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_rule_type"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_rule_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "missing_group_key"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_rule_type"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_rule_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "dependency_error"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_rule_type"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_rule_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "$feature_flag_reason_code": {
                "const": "error"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_rule_type"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_rule_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "description": "A local-only outcome with no matrix row: the server never returns flag_disabled, and the call carries no rule or experiment attribution.",
            "properties": {
              "$feature_flag_reason_code": {
                "const": "flag_disabled"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_rule_type"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_rule_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          },
          {
            "description": "A tolerant reader may emit a diagnostic call for a malformed split after omitting all rule/experiment attribution. The config marker and reason remain available for diagnostics.",
            "properties": {
              "$feature_flag_reason_code": {
                "const": "experiment_split"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "$feature_flag_rule_type"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_rule_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_experiment_id"
                  ]
                },
                {
                  "required": [
                    "$feature_flag_variant"
                  ]
                }
              ]
            }
          }
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "$feature_flag_rule_id"
              ]
            },
            {
              "required": [
                "$feature_flag_rule_type"
              ]
            }
          ]
        }
      }
    }
  ]
}
